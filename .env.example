# SingleStep — copy this file to ".env" and fill in your key.
# Get a FREE Groq API key at https://console.groq.com (sign up, create an API key).
# The app works WITHOUT a key too: it automatically uses the built-in
# deterministic heuristic micro-slicer as a fallback. No key is ever
# committed to git — ".env" is gitignored by default in most setups.
GROQ_API_KEY=your_groq_api_key_here
# Optional: change the port the Flask app listens on (default 5000).
PORT=5000
